<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>同步笔记应用</title>
    <!-- 添加Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script>
    <style>
        /* 保持原有样式不变，可以添加一个同步状态指示器 */
        .sync-status {
            position: fixed;
            bottom: 20px;
            right: 20px;
            padding: 8px 15px;
            border-radius: 20px;
            background-color: #f1f1f1;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            font-size: 14px;
        }
        .sync-status.syncing {
            background-color: #fff3cd;
        }
        .sync-status.synced {
            background-color: #d4edda;
        }
        .sync-status.error {
            background-color: #f8d7da;
        }
        /* 原有CSS样式保持不变 */
        * {
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            margin: 0;
            padding: 20px;
            background-color: #f5f5f5;
            color: #333;
        }
        
        /* ... 保持原有所有其他样式不变 ... */
    </style>
</head>
<body>
    <div class="container">
        <h1>同步笔记应用</h1>
        
        <div class="app-header">
            <input type="text" class="search-box" placeholder="搜索笔记...">
            <button class="new-note-btn" id="newNoteBtn">新建笔记</button>
        </div>
        
        <div class="notes-container" id="notesContainer">
            <div class="empty-state" id="emptyState">
                <p>正在加载笔记...</p>
            </div>
        </div>
    </div>
    
    <!-- 笔记编辑器弹窗 -->
    <div class="note-editor" id="noteEditor">
        <div class="editor-container">
            <div class="editor-header">
                <h2 id="editorTitle">编辑笔记</h2>
                <button class="editor-btn close-btn" id="closeEditorBtn">&times;</button>
            </div>
            <input type="text" class="editor-title" id="noteTitleInput" placeholder="笔记标题">
            <textarea class="editor-content" id="noteContentInput" placeholder="在这里输入笔记内容..."></textarea>
            <div class="editor-actions">
                <button class="editor-btn cancel-btn" id="cancelEditBtn">取消</button>
                <button class="editor-btn save-btn" id="saveNoteBtn">保存</button>
            </div>
        </div>
    </div>
    
    <!-- 同步状态指示器 -->
    <div class="sync-status" id="syncStatus">未连接</div>
    
    <script>
        // 替换为您的Firebase配置
        const firebaseConfig = {
            apiKey: "AIzaSyDbuELvcjBmHDZxrU36KN0WCdtsQerwWr4",
            authDomain: "web-note-d3f21.firebaseapp.com",
            databaseURL: "YOUR_DATABASE_URL",
            projectId: "web-note-d3f21",
            storageBucket: "web-note-d3f21.firebasestorage.app",
            messagingSenderId: "72403416738",
            appId: "1:72403416738:web:14c36e4eeeb7652e6789fb"
        };
        
        // 初始化Firebase
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();
        
        document.addEventListener('DOMContentLoaded', function() {
            // 获取DOM元素
            const notesContainer = document.getElementById('notesContainer');
            const emptyState = document.getElementById('emptyState');
            const newNoteBtn = document.getElementById('newNoteBtn');
            const noteEditor = document.getElementById('noteEditor');
            const noteTitleInput = document.getElementById('noteTitleInput');
            const noteContentInput = document.getElementById('noteContentInput');
            const saveNoteBtn = document.getElementById('saveNoteBtn');
            const cancelEditBtn = document.getElementById('cancelEditBtn');
            const closeEditorBtn = document.getElementById('closeEditorBtn');
            const searchBox = document.querySelector('.search-box');
            const syncStatus = document.getElementById('syncStatus');
            
            // 当前编辑的笔记ID
            let currentNoteId = null;
            let userId = generateUserId();
            
            // 生成简单用户ID (基于设备)
            function generateUserId() {
                let id = localStorage.getItem('notesAppUserId');
                if (!id) {
                    id = 'user-' + Math.random().toString(36).substr(2, 9);
                    localStorage.setItem('notesAppUserId', id);
                }
                return id;
            }
            
            // 更新同步状态显示
            function updateSyncStatus(status, message) {
                syncStatus.textContent = message;
                syncStatus.className = 'sync-status ' + status;
            }
            
            // 从Firebase加载笔记
            function loadNotes(searchTerm = '') {
                updateSyncStatus('syncing', '同步中...');
                
                const notesRef = database.ref('users/' + userId + '/notes');
                
                notesRef.on('value', (snapshot) => {
                    const notesData = snapshot.val() || {};
                    const notes = Object.keys(notesData).map(key => {
                        return { id: key, ...notesData[key] };
                    });
                    
                    notesContainer.innerHTML = '';
                    
                    const filteredNotes = searchTerm 
                        ? notes.filter(note => 
                            note.title.toLowerCase().includes(searchTerm.toLowerCase()) || 
                            note.content.toLowerCase().includes(searchTerm.toLowerCase()))
                        : notes;
                    
                    if (filteredNotes.length === 0) {
                        emptyState.textContent = searchTerm ? '没有找到匹配的笔记' : '暂无笔记，点击"新建笔记"按钮开始记录';
                        emptyState.style.display = 'block';
                    } else {
                        emptyState.style.display = 'none';
                        // 按更新时间降序排序
                        filteredNotes.sort((a, b) => b.updatedAt - a.updatedAt);
                        filteredNotes.forEach(note => {
                            const noteCard = createNoteCard(note);
                            notesContainer.appendChild(noteCard);
                        });
                    }
                    
                    updateSyncStatus('synced', '已同步: ' + new Date().toLocaleTimeString());
                }, (error) => {
                    console.error('同步失败:', error);
                    updateSyncStatus('error', '同步失败');
                });
            }
            
            // 创建笔记卡片 (保持原有实现不变)
            function createNoteCard(note) {
                const noteCard = document.createElement('div');
                noteCard.className = 'note-card';
                noteCard.dataset.id = note.id;
                
                const title = document.createElement('div');
                title.className = 'note-title';
                title.textContent = note.title || '无标题';
                
                const content = document.createElement('div');
                content.className = 'note-content';
                content.textContent = note.content || '无内容';
                
                const date = document.createElement('div');
                date.className = 'note-date';
                date.textContent = formatDate(note.updatedAt);
                
                noteCard.appendChild(title);
                noteCard.appendChild(content);
                noteCard.appendChild(date);
                
                noteCard.addEventListener('click', () => openEditor(note.id));
                
                return noteCard;
            }
            
            // 格式化日期 (保持原有实现不变)
            function formatDate(timestamp) {
                const date = new Date(timestamp);
                return date.toLocaleString();
            }
            
            // 打开编辑器 (保持原有实现不变)
            function openEditor(noteId = null) {
                currentNoteId = noteId;
                
                if (noteId) {
                    // 从Firebase获取单个笔记
                    const noteRef = database.ref('users/' + userId + '/notes/' + noteId);
                    noteRef.once('value').then((snapshot) => {
                        const note = snapshot.val();
                        if (note) {
                            noteTitleInput.value = note.title || '';
                            noteContentInput.value = note.content || '';
                            noteEditor.classList.add('active');
                            noteTitleInput.focus();
                        }
                    });
                } else {
                    // 新建笔记
                    noteTitleInput.value = '';
                    noteContentInput.value = '';
                    noteEditor.classList.add('active');
                    noteTitleInput.focus();
                }
            }
            
            // 关闭编辑器 (保持原有实现不变)
            function closeEditor() {
                noteEditor.classList.remove('active');
                currentNoteId = null;
            }
            
            // 保存笔记到Firebase
            function saveNote() {
                const title = noteTitleInput.value.trim();
                const content = noteContentInput.value.trim();
                
                if (!title && !content) {
                    alert('笔记标题和内容不能同时为空');
                    return;
                }
                
                const now = new Date().getTime();
                const notesRef = database.ref('users/' + userId + '/notes');
                
                updateSyncStatus('syncing', '保存中...');
                
                if (currentNoteId) {
                    // 更新现有笔记
                    const updates = {
                        title,
                        content,
                        updatedAt: now
                    };
                    
                    database.ref('users/' + userId + '/notes/' + currentNoteId).update(updates)
                        .then(() => {
                            closeEditor();
                            updateSyncStatus('synced', '已保存: ' + new Date().toLocaleTimeString());
                        })
                        .catch((error) => {
                            console.error('保存失败:', error);
                            updateSyncStatus('error', '保存失败');
                        });
                } else {
                    // 添加新笔记
                    const newNoteRef = notesRef.push();
                    newNoteRef.set({
                        title,
                        content,
                        createdAt: now,
                        updatedAt: now
                    })
                    .then(() => {
                        closeEditor();
                        updateSyncStatus('synced', '已保存: ' + new Date().toLocaleTimeString());
                    })
                    .catch((error) => {
                        console.error('保存失败:', error);
                        updateSyncStatus('error', '保存失败');
                    });
                }
            }
            
            // 删除笔记 (可选功能)
            function deleteNote(noteId) {
                if (confirm('确定要删除这篇笔记吗？')) {
                    updateSyncStatus('syncing', '删除中...');
                    
                    database.ref('users/' + userId + '/notes/' + noteId).remove()
                        .then(() => {
                            updateSyncStatus('synced', '已删除: ' + new Date().toLocaleTimeString());
                        })
                        .catch((error) => {
                            console.error('删除失败:', error);
                            updateSyncStatus('error', '删除失败');
                        });
                }
            }
            
            // 事件监听 (保持原有实现不变，可添加删除功能)
            newNoteBtn.addEventListener('click', () => openEditor());
            saveNoteBtn.addEventListener('click', saveNote);
            cancelEditBtn.addEventListener('click', closeEditor);
            closeEditorBtn.addEventListener('click', closeEditor);
            
            noteEditor.addEventListener('click', function(e) {
                if (e.target === noteEditor) {
                    closeEditor();
                }
            });
            
            searchBox.addEventListener('input', function() {
                loadNotes(this.value);
            });
            
            // 初始化加载笔记
            loadNotes();
        });
    </script>
</body>
</html>
